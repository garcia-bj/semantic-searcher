generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OwlDocument {
  id           Int       @id @default(autoincrement())
  fileName     String
  originalName String?
  mimeType     String?   @default("application/rdf+xml")
  size         BigInt?
  uploadedAt   DateTime  @default(now())
  parsedAt     DateTime?
  tripleCount  Int       @default(0)
  hasError     Boolean   @default(false)
  errorMessage String?
  triples      Triple[]

  @@map("owl_documents")
}

model Triple {
  id         Int         @id @default(autoincrement())
  documentId Int
  graph      String?
  subject    String
  predicate  String
  object     String
  isLiteral  Boolean     @default(false)
  datatype   String?
  lang       String?
  inferredBy String?
  isInferred Boolean     @default(false)
  document   OwlDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([subject])
  @@index([predicate])
  @@index([object])
  @@index([subject, predicate])
  @@index([predicate, object])
  @@index([graph])
  @@index([isInferred])
  @@map("triples")
}

model documents {
  id         Int      @id @default(autoincrement())
  nombre     String
  publicId   String   @unique
  url        String
  size       BigInt?
  mimeType   String?
  uploadedAt DateTime @default(now())
}
